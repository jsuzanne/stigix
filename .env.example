# Stigix - Environment Configuration Example

# --- General & Security ---
# Internal port for the Dashboard
PORT=8080
# Secret for session tokens (Required for MCP & Dashboard auth)
# Generate a secure random string!
JWT_SECRET=your-secure-secret-here
# Enable verbose backend logging (true/false)
DEBUG=false

# --- Deployment Role ---
# Role can be: both, target, or source
STIGIX_ROLE=both
# Custom site name for dashboard display
STIGIX_SITE_NAME=local-node

# --- Prisma SD-WAN API (Optional) ---
# Required for Cloud Autodiscovery, Flow Search, and SaaS enrichment
# PRISMA_SDWAN_REGION=Germany
# PRISMA_SDWAN_TSGID=
# PRISMA_SDWAN_CLIENT_ID=
# PRISMA_SDWAN_CLIENT_SECRET=

# --- Node Mode & Rendezvous Relay (Optional) ---
# Default mode is 'standalone' (0 external calls, 0 Cloudflare dependency).
# If switching to 'peer', direct LAN peering uses STIGIX_CONTROLLER_URL without Cloudflare.
# Set STIGIX_REGISTRY_ENABLED=true only if using a Cloudflare Rendezvous Relay for multi-site WAN traversal behind NATs.
STIGIX_REGISTRY_ENABLED=false
STIGIX_REGISTRY_MODE=standalone
# STIGIX_REGISTRY_URL=https://your-relay-worker.workers.dev

# --- Direct Controller Mode (Peer Installation) ---
# Set this to join a specific Stigix leader directly (LAN/private IP/VPN), bypassing any relay.
# This is automatically written by the --controller flag of install.sh.
# STIGIX_CONTROLLER_URL=http://192.168.1.10:3000

# --- Synthetic Cloud Target Worker (Optional Probes) ---
# Base URL of your self-deployed Cloudflare target worker for latency / TTFB / SaaS probes.
# Leave commented if not running synthetic probes against Cloudflare Edge.
# STIGIX_TARGET_BASE_URL=https://your-target-worker.workers.dev

# --- Traffic Generator ---
AUTO_START_TRAFFIC=true
SLEEP_BETWEEN_REQUESTS=1
CLIENT_ID=client01

# --- Local Target Simulation (8082) ---
# Baseline latency for SLOW modes (seconds)
SLOW_DELAY_SECONDS=5
# Port for the local target service
TARGET_HTTP_PORT=8082

# --- XFR Bandwidth Testing ---
# Port for XFR throughput testing
XFR_PORT=9000
# Max bandwidth rate allowed (Mbps)
XFR_RATE_LIMIT=2
# Max duration per test run (seconds)
XFR_MAX_DURATION=60

# --- PCAP Stateful Replay Engine (Beta / Experimental) ---
# Enable PCAP upload, L7 flow extraction, and stateful replay
ENABLE_PCAP_REPLAY=false
# Maximum PCAP file upload size in MB (default: 100)
PCAP_MAX_UPLOAD_MB=100

# --- ChangeGuard Snapshot & Delta Engine (Pilot / Beta) ---
# Enable pre/post migration state capture and delta diffing (tunnels, DEM, confidence scoring)
ENABLE_CHANGE_SNAPSHOTS=false

# --- High-Performance Go Engine (Experimental / Benchmark) ---
# Mandatory feature flag to unlock the native Go engine switcher (stigix-go) for Traffic, Voice RTP, UDP Echo, and Convergence
ENABLE_GO_ENGINE=false

